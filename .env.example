# Copy to .env, replace every placeholder, and never commit the populated file.
POSTGRES_PASSWORD=replace-me-with-a-random-database-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:replace-me-with-a-random-database-password@localhost:5432/dream_motif
REDIS_URL=redis://localhost:6379/0
ENV=development
BUILD_SHA=unknown

# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=replace-me-with-a-random-secret-of-at-least-32-bytes

ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_CHAT_ID=0
TELEGRAM_MINI_APP_URL=

GOOGLE_DOC_ID=replace-me
GOOGLE_DOC_IDS=
# Host path used only with docker-compose.google-service-account.yml.
GOOGLE_SERVICE_ACCOUNT_HOST_FILE=
# In direct-process deployments, set the path visible to that process.
# The optional Compose overlay sets this container path itself.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_API_TIMEOUT_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_SECONDS=300
MOTIF_INDUCTION_ENABLED=true
RESEARCH_AUGMENTATION_ENABLED=false
RESEARCH_API_KEY=

VOICE_MEDIA_DIR=/tmp/dream_voice
VOICE_RETENTION_SECONDS=3600
VOICE_TRANSCRIPT_RETENTION_SECONDS=604800
