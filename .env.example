# Copy to .env for local/private deployment. Never commit the populated .env file.

# Core storage. docker-compose.yml overrides the hosts to postgres/redis inside the network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dream_motif
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-at-least-32-random-characters
ENV=production

# Provider keys. Capture remains durable when enrichment providers are unavailable,
# but semantic search, transcription, or interpretation may be degraded.
ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_THRESHOLD=0.20
MAX_INDEX_AGE_HOURS=24

# Telegram private operator.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ALLOWED_CHAT_ID=0
TELEGRAM_MINI_APP_URL=https://your-private-host.example/dream-memory/mini-app
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_NUMERIC_FEEDBACK_ENABLED=false
VOICE_MEDIA_DIR=/tmp/dream_voice
VOICE_RETENTION_SECONDS=3600
APP_TIMEZONE=Asia/Tbilisi

# Current Google Docs adapter. The private-beta target makes Google optional,
# but the current Settings model still requires a placeholder GOOGLE_DOC_ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DOC_ID=not-configured
GOOGLE_DOC_IDS=
GOOGLE_OWNER_EMAIL=
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_SECONDS=300

# Optional analytical features.
MOTIF_INDUCTION_ENABLED=true
RESEARCH_AUGMENTATION_ENABLED=false
RESEARCH_API_BASE_URL=https://api.tavily.com
RESEARCH_API_KEY=
BULK_CONFIRM_TOKEN_TTL_SECONDS=600
